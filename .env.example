# Socialpruf — one key per org. Slugs must match config/orgs.json.
SP_KEY_NHL_LEAGUE=
SP_KEY_CREATORS=
SP_KEY_BRANDS=

SP_API_BASE=https://socialpruf.com

# Anthropic. Deliberately NOT named ANTHROPIC_API_KEY — that variable
# makes Claude Code bill to API rates instead of your Pro subscription.
SP_ANTHROPIC_KEY=

# X / Twitter (only needed for `pnpm post`)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
