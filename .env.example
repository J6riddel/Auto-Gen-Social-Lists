# Socialpruf — one key per org. Slugs must match config/orgs.json.
SP_KEY_NHL_LEAGUE=
SP_KEY_NFL_LEAGUE=
SP_KEY_NBA_LEAGUE=
SP_KEY_MLB_LEAGUE=
SP_KEY_CREATORS=
SP_KEY_BRANDS=

# Power Four college football. One key for all four conference orgs (sec,
# big-ten, big-12, acc) — they're split by ESPN conference, not by key. Give
# each org its own keyEnv in config/orgs.json if they land in separate
# Socialpruf workspaces instead.
SP_KEY_PWR4_LEAGUE=

SP_API_BASE=https://socialpruf.com

# Anthropic. Deliberately NOT named ANTHROPIC_API_KEY — that variable
# makes Claude Code bill to API rates instead of your Pro subscription.
SP_ANTHROPIC_KEY=

# X / Twitter (only needed for `pnpm post`)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
